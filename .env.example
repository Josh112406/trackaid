# Public Supabase connection values. Safe for browser use when RLS is enabled.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase key. Never expose or prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# PayMongo test credentials only for development and previews.
NEXT_PUBLIC_PAYMONGO_PUBLIC_KEY=
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
PAYMONGO_LIVE_MODE=false

# Polygon Amoy audit recorder. Keep the signer key server-only.
POLYGON_AMOY_RPC_URL=
TRACKAID_LEDGER_ADDRESS=
TRACKAID_RECORDER_PRIVATE_KEY=

# Protects the internal ledger worker endpoint.
CRON_SECRET=
