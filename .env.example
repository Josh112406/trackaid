# Public Supabase connection values. Safe for browser use when RLS is enabled.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=https://trackaid.vercel.app

# Server-only Supabase key. Never expose or prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# PayMongo keys must all belong to the same mode. Start in test mode, then
# switch the secret, public key, webhook secret, and flag together for launch.
NEXT_PUBLIC_PAYMONGO_PUBLIC_KEY=
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
PAYMONGO_LIVE_MODE=false

# Solana Devnet audit recorder. The 64-byte signer key is base64 encoded and
# remains server-only. The public signer address is safe to display.
SOLANA_DEVNET_RPC_URL=https://api.devnet.solana.com
SOLANA_LEDGER_SIGNER_ADDRESS=
SOLANA_LEDGER_SECRET_KEY=

# Protects the internal ledger worker endpoint.
CRON_SECRET=

# Optional dedicated HMAC pepper for non-reversible abuse-prevention counters.
# Use at least 32 random characters and keep it server-only. When omitted, the
# server-only Supabase secret key is used as the HMAC key.
SECURITY_HASH_PEPPER=
